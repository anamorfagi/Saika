{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "auto_open_browser": true
  },
  "llm": {
    "backend": "ollama",
    "ollama_url": "http://127.0.0.1:11434",
    "lmstudio_url": "http://127.0.0.1:1234",
    "model": "gemma4:e4b",
    "temperature": 0.8,
    "max_history": 14,
    "think": false,
    "cloud": {
      "enabled": true,
      "provider": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "meta-llama/llama-3.3-70b-instruct:free"
    },
    "tools_broken": [
      "google/gemma-4-12b-qat",
      "llama3.2:latest"
    ]
  },
  "tools": {
    "enabled": true,
    "handspc_url": "http://127.0.0.1:8767",
    "max_rounds": 3,
    "timeout_s": 60,
    "browser_model": "qwen3.6:latest"
  },
  "mic": {
    "server_capture": true,
    "device": null
  },
  "attention": {
    "enabled": true,
    "name_prefixes": [
      "сайк",
      "saik"
    ],
    "window_s": 30,
    "fuzzy_max_edits": 1,
    "always": true,
    "stop_words": [
      "стоп",
      "стой",
      "хватит",
      "замолчи",
      "молчи",
      "помолчи",
      "тихо",
      "тише",
      "заткнись",
      "остановись",
      "стопэ"
    ]
  },
  "stt": {
    "engine": "gigaam",
    "language": "ru",
    "sample_rate": 16000,
    "vad": {
      "rms_threshold": 0.012,
      "silence_ms": 700,
      "min_speech_ms": 300,
      "max_segment_s": 25
    },
    "fallback_order": [
      "faster_whisper",
      "gigaam",
      "vosk",
      "whispercpp",
      "tone"
    ],
    "engines": {
      "faster_whisper": {
        "model": "large-v3-turbo",
        "device": "auto",
        "compute_type": "auto"
      },
      "gigaam": {
        "model": "v3_e2e_rnnt"
      },
      "vosk": {
        "model_dir": "models/vosk-model-small-ru-0.22"
      },
      "whispercpp": {
        "model": "medium",
        "n_threads": 8
      },
      "tone": {},
      "voxtral": {
        "model": "mistralai/Voxtral-Mini-4B-Realtime-2602",
        "venv": ".venv_voxtral",
        "worker": "workers/voxtral_worker.py",
        "setup": "setup/install_voxtral.bat",
        "port": 8766,
        "timeout_s": 180
      }
    }
  },
  "tts": {
    "engine": "qwen3",
    "enabled": true,
    "disabled": [],
    "voice_ref": "voice/ref.mp3",
    "voice_ref_wav": "voice/ref.wav",
    "voice_ref_text": "Я проснулась раньше будильника, когда комната всё ещё была укутана синим рассветом. Несколько секунд я просто слушала своё дыхание и ощущала тихую тяжесть грядущего дня. Раньше утра пугали меня, слишком много ожиданий, слишком много незавершённых мыслей. Теперь они кажутся чистыми страницами. Я сварила кофе, наблюдая, как поднимается пар, словно что-то живое, и улыбнулась этому маленькому ритуалу. Снаружи город медленно просыпался, притворяясь спокойным. Я надела куртку и вышла в холодный воздух, позволяя ему прояснить голову. Я не знаю точно, куда иду, и, к моему удивлению, это больше не тревожит. Я поняла, что движение вперёд не всегда требует идеального плана. Иногда достаточно доверять собственным шагам, даже если они не уверены.",
    "fallback_order": [
      "qwen3",
      "silero",
      "edge"
    ],
    "qwen3": {
      "model": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
      "language": "Russian",
      "emit_every_frames": 4,
      "decode_window_frames": 80,
      "attn": "auto",
      "optimize": true
    },
    "silero": {
      "speaker": "xenia",
      "sample_rate": 48000
    },
    "edge": {
      "voice": "ru-RU-SvetlanaNeural"
    }
  },
  "memory": {
    "db_path": "data/saika_memory.db",
    "chroma_path": "data/chroma",
    "raw_limit_messages": 500,
    "raw_limit_hours": 4,
    "compress_raw_every_min": 120,
    "core_update_every_days": 7,
    "episode_hard_cap": 10000,
    "regular_min_sessions": 3,
    "regular_min_messages": 30,
    "stranger_ttl_days": 30,
    "rag_top_k": 5
  },
  "dreampc": {
    "model": "inclusionAI/LLaDA-MoE-7B-A1B-Instruct",
    "venv": ".venv_dreampc",
    "worker": "workers/dreampc_worker.py",
    "setup": "setup/install_dreampc.bat",
    "port": 8768,
    "quant": "4bit",
    "steps": 128,
    "gen_length": 128,
    "block_length": 32,
    "temperature": 0.0,
    "timeout_s": 1800
  },
  "owner": {
    "name": "Anamorf",
    "id": "owner"
  },
  "assistant_name": "Сайка",
  "messengers": {
    "pc_name": "домашний-ПК",
    "control_enabled": false,
    "owner_ids": {
      "telegram": [],
      "vk": []
    },
    "telegram": {
      "enabled": false,
      "token": ""
    },
    "vk": {
      "enabled": false,
      "token": "",
      "group_id": ""
    },
    "aliases": {
      "впн": [
        "happ",
        "amnezia"
      ],
      "vpn": [
        "happ",
        "amnezia"
      ],
      "хапп": "happ",
      "амнезия": "amnezia"
    },
    "kill_allowlist": [],
    "kill_denylist": [],
    "launch_allowlist": {}
  },
  "training": {
    "venv": ".venv_train",
    "worker": "workers/train_worker.py",
    "setup": "setup/install_train.bat",
    "port": 8769,
    "base_model": "unsloth/gemma-3n-E4B-it",
    "lora_r": 16,
    "lora_alpha": 16,
    "lora_dropout": 0.0,
    "learning_rate": 0.0002,
    "epochs": 3,
    "batch_size": 2,
    "grad_accum": 4,
    "max_seq_len": 1024,
    "output_name": "saika-char",
    "dataset_dir": "training/dataset"
  },
  "locallm": {
    "port": 8770,
    "model": "huihui-ai/Huihui-Qwen3.5-9B-abliterated",
    "max_new_tokens": 2048,
    "engine": "llamacpp"
  },
  "locallm_gguf": {
    "repo": "mradermacher/Huihui-Qwen3.5-9B-abliterated-i1-GGUF",
    "quant": "Q4_K_M",
    "n_ctx": 8192
  }
}
