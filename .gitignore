# окружения — восстанавливаются start.bat / install_voxtral / install_dreampc
.venv/
.venv_voxtral/
.venv_dreampc/
.venv_locallm/
.venv_locallm_gguf/
.venv_train/
.venv_omni/

# модели и кэши — качаются сами (гигабайты)
models/
.pip_cache/
.pip_tmp/

# сторонние репозитории — клонирует setup/first_run.py
third_party/

# локальный ffmpeg — качает setup (бинарники, ~100 МБ; лимит GitHub)
tools/ffmpeg/

# личный голосовой референс — публичному репо его видеть не надо
voice/

# личные данные и рантайм
data/
logs/
.setup_state.json

# секреты (токены ботов мессенджеров — ключ от ПК, в репо им не место)
secrets.json

# настройки ЭТОЙ машины (2026-07-25): бэкенд, модель, движок слуха,
# устройство вывода, номер камеры. Накладываются поверх config.json при
# загрузке, поэтому переживают git pull — раньше после каждого синка
# приходилось руками возвращать свои значения.
config.local.json

# мусор
__pycache__/
*.pyc
Saika_portable.zip
Saika_package_skipped.txt

# HandsPC («руки»: веб-поиск и пр.) переехал внутрь проекта 2026-07-25.
# Код (server.py, run.bat) пушим, а venv/логи — нет: venv run.bat пересоздаёт
# сам на любой машине, если его нет или он «переехал».
HandsPC/.venv/
HandsPC/logs/
HandsPC/__pycache__/

# рабочая свалка ассистента (переносим сюда то, что нельзя удалить с диска)
_to_delete/
